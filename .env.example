# =============================================================================
#  MikroTik Cloud Manager — environment variables
#  Copy this file to .env and fill in the values. NEVER commit the real .env.
#  cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1) DATABASE  (REQUIRED)
# -----------------------------------------------------------------------------
# Local development: SQLite file (relative to the project root is fine)
#   DATABASE_URL="file:./db/custom.db"
#
# Vercel / production: PostgreSQL (SQLite does NOT work on serverless — the
# filesystem is read-only). The build auto-detects a postgres:// URL and uses
# prisma/schema.prod.prisma to generate the matching Prisma client.
#
# IMPORTANT for Supabase: use the TRANSACTION POOLER URL (port 6543), not the
# direct connection (port 5432) — direct is blocked from Vercel/serverless.
# Get it from: Supabase Dashboard -> Project Settings -> Database ->
#   Connection string -> "Transaction pooler" tab. Format:
#   postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
#
# After setting it, run once to create the tables:
#   npm run db:push:prod
DATABASE_URL="file:./db/custom.db"

# Optional: force a specific Prisma schema during `prisma generate`.
# Leave unset — the build script picks SQLite locally and PostgreSQL on Vercel.
# PRISMA_SCHEMA="prisma/schema.prisma"

# -----------------------------------------------------------------------------
# 2) SECRETS  (REQUIRED in production)
# -----------------------------------------------------------------------------
# AES-256 key used to encrypt router API passwords at rest AND to sign session
# tokens. Use a long random string. If unset, an insecure fallback is used.
# Generate one with: openssl rand -base64 48
APP_SECRET="change-me-to-a-long-random-secret"

# -----------------------------------------------------------------------------
# 3) PLATFORM URLS
# -----------------------------------------------------------------------------
# Public URL the router can reach for one-command enrollment (/api/onboard/...).
# If unset it is derived from the request host. Set it on Vercel if needed.
# PUBLIC_PLATFORM_URL="https://migatik.vercel.app"

# Public WebSocket URL shown in the agent UI (realtime service, port 3003).
# PUBLIC_AGENT_URL="wss://your-agent-host.example.com"

# -----------------------------------------------------------------------------
# 4) REALTIME SERVICE (mini-services/realtime-service)
# -----------------------------------------------------------------------------
# Where the Next.js server reaches the agent tunnel bridge.
REALTIME_URL="http://127.0.0.1:3003"
# Shared secret between the platform and the realtime bridge. Must match on both.
BRIDGE_TOKEN="change-me-bridge-token"
# Browser-facing realtime URL (only needed if different from the current host).
# NEXT_PUBLIC_REALTIME_URL="http://127.0.0.1:3003"

# -----------------------------------------------------------------------------
# 5) AGENT (agent/agent.js — set in agent.env on the machine running the agent)
# -----------------------------------------------------------------------------
# AGENT_URL="ws://your-platform:3003"
# AGENT_TOKEN="token-from-agent-enroll-code"
# AGENT_NAME="branch-agent-01"
# Optional: register a local router directly from env vars
# ROUTER_HOST="192.168.88.1"
# ROUTER_PORT="8728"
# ROUTER_USER="admin"
# ROUTER_PASS=""
# ROUTER_TLS="0"
# ROUTER_NAME="My Router"
# AGENT_GATEWAY_PORT=""
# AGENT_TLS_INSECURE="0"

# -----------------------------------------------------------------------------
# 6) TEST SCRIPTS (optional — only used by scripts/*.ts)
# -----------------------------------------------------------------------------
# PLATFORM_URL="http://localhost:3000"
# ROUTER_HOST="192.168.1.3"
# ROUTER_PORT="8728"
# ROUTER_USER="admin"
# ROUTER_PASS=""
# ROUTER_TLS="0"
# WRITE_DB="0"
